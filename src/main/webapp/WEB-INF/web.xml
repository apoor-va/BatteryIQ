<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>BatteryIQ - Automotive Marketplace &amp; Vehicle Health Verification</display-name>
    <description>
        BatteryIQ - The complete Automotive Marketplace for Cars, Bikes and Scooters across Petrol, Diesel and Electric.
        Featuring revolutionary certified Vehicle Health Reports.
    </description>

    <!-- Context Parameters for Database Connection -->
    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/batteryiq_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>dbPass</param-name>
        <param-value></param-value>
    </context-param>

    <!-- 1. Home Controller -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.batteryiq.controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- 2. Vehicle List & Search Controller -->
    <servlet>
        <servlet-name>VehicleListController</servlet-name>
        <servlet-class>com.batteryiq.controller.VehicleListController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/vehicles</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/cars</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/bikes</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/scooters</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/new-vehicles</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/used-vehicles</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VehicleListController</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <!-- 3. Vehicle Detail Controller -->
    <servlet>
        <servlet-name>VehicleDetailController</servlet-name>
        <servlet-class>com.batteryiq.controller.VehicleDetailController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehicleDetailController</servlet-name>
        <url-pattern>/vehicle</url-pattern>
    </servlet-mapping>

    <!-- 4. Compare Controller -->
    <servlet>
        <servlet-name>CompareController</servlet-name>
        <servlet-class>com.batteryiq.controller.CompareController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompareController</servlet-name>
        <url-pattern>/compare</url-pattern>
    </servlet-mapping>

    <!-- 5. Sell Vehicle Controller -->
    <servlet>
        <servlet-name>SellVehicleController</servlet-name>
        <servlet-class>com.batteryiq.controller.SellVehicleController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellVehicleController</servlet-name>
        <url-pattern>/sell</url-pattern>
    </servlet-mapping>

    <!-- 6. Health Report Controller -->
    <servlet>
        <servlet-name>HealthReportController</servlet-name>
        <servlet-class>com.batteryiq.controller.HealthReportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthReportController</servlet-name>
        <url-pattern>/health-report</url-pattern>
    </servlet-mapping>

    <!-- 7. Battery Diagnostic Lab Controller -->
    <servlet>
        <servlet-name>BatteryLabController</servlet-name>
        <servlet-class>com.batteryiq.controller.BatteryLabController</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>BatteryLabController</servlet-name>
        <url-pattern>/battery-lab</url-pattern>
    </servlet-mapping>

    <!-- 8. Battery API Proxy Controller -->
    <servlet>
        <servlet-name>BatteryApiController</servlet-name>
        <servlet-class>com.batteryiq.controller.BatteryApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BatteryApiController</servlet-name>
        <url-pattern>/api/battery/*</url-pattern>
    </servlet-mapping>

    <!-- 9. Executive Dashboard Controller -->
    <servlet>
        <servlet-name>DashboardController</servlet-name>
        <servlet-class>com.batteryiq.controller.DashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardController</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 10. Battery Analytics & Comparison Controller -->
    <servlet>
        <servlet-name>BatteryAnalyticsController</servlet-name>
        <servlet-class>com.batteryiq.controller.BatteryAnalyticsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BatteryAnalyticsController</servlet-name>
        <url-pattern>/battery-analytics</url-pattern>
    </servlet-mapping>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
